# PostgreSQL connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pubgstats
SPRING_DATASOURCE_USERNAME=pubgstats
SPRING_DATASOURCE_PASSWORD=pubgstats

# PUBG API (used in later phases)
PUBG_API_KEY=
PUBG_SHARD=steam
# Background refresh schedule as a Spring cron expression. Default: daily at 03:00.
PUBG_REFRESH_CRON=0 0 3 * * *
# Comma-separated player handles. First is the user handle, the rest are pro players.
PUBG_PLAYERS=shroud,chocoTaco,TGLTN,WackyJacky101,Pio
